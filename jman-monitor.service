[Unit]
Description=jman Monitoring Service
After=network.target

[Service]
Type=simple
# Ensure the path matches your installation location
ExecStart=/usr/local/bin/jman-monitor --service
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Optional: Run as a specific user
# User=jman
# Group=jman

# Optional: Set working directory if needed for config loading
# WorkingDirectory=/opt/jman

[Install]
WantedBy=multi-user.target
